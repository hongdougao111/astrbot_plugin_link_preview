#!/bin/sh
# 推 v* 标签时校验 metadata.yaml 的 version 和标签是否一致。
# 装了 PortableGit 的话，这个脚本用 sh 跑没问题。

remote="$1"

# stdin 每行是：<local ref> SP <local sha> SP <remote ref> SP <remote sha>
while read local_ref local_sha remote_ref remote_sha; do
    case "$local_ref" in
        refs/tags/v*)
            tag=$(basename "$local_ref")
            echo "检查版本号：$tag"
            if ! python scripts/check_version.py "$tag"; then
                echo ""
                echo "推送被拦下：metadata.yaml 的 version 和标签对不上。"
                echo "改好再推，或者用 python scripts/check_version.py --bump patch 升版本。"
                exit 1
            fi
            ;;
    esac
done

exit 0
